APP_NAME="Sistema Salomão"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://seu-app.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=error

# --- Database (Supabase PostgreSQL) ---
DB_CONNECTION=supabase
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=

# --- Supabase ---
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_seu-token-aqui
SUPABASE_PUBLISHABLE_KEY=sb_publishable_seu-token-aqui

# --- Clerk Authentication (https://clerk.com) ---
CLERK_PUBLISHABLE_KEY=pk_test_seu-token-aqui
CLERK_SECRET_KEY=sk_test_seu-token-aqui
CLERK_FRONTEND_API_URL=https://sua-instancia.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=whsec_seu-token-aqui
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=${CLERK_PUBLISHABLE_KEY}

# --- API gov.br - Consulta CPF ---
# Obtenha o token em portal.conecta.apim.gov.br
CPF_API_TOKEN=seu-token-aqui

# --- Inertia ---
INERTIA_SSR_ENABLED=false
INERTIA_USE_SCRIPT_ELEMENT_FOR_INITIAL_PAGE=true

# --- Cache / Session ---
BROADCAST_DRIVER=log
CACHE_DRIVER=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# --- Vite ---
VITE_APP_NAME="${APP_NAME}"
VITE_CLERK_PUBLISHABLE_KEY="${CLERK_PUBLISHABLE_KEY}"
