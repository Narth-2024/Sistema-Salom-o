APP_NAME="Sistema Salomão"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stderr
LOG_LEVEL=error

# --- Database (Supabase PostgreSQL) ---
# Local: host direto (IPv6). Produção (Vercel): session pooler IPv4.
DB_CONNECTION=supabase
DB_HOST=db.SEU-REF.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=

# --- Supabase ---
# Use as chaves LEGACY em formato JWT (eyJ...): Dashboard → Settings → API.
# As chaves no formato sb_secret_/sb_publishable_ NÃO funcionam (Storage/PostgREST rejeitam).
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_PUBLISHABLE_KEY=eyJ...

# --- Clerk Authentication (https://clerk.com) ---
CLERK_PUBLISHABLE_KEY=pk_test_seu-token-aqui
CLERK_SECRET_KEY=sk_test_seu-token-aqui
CLERK_FRONTEND_API_URL=https://sua-instancia.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=whsec_seu-token-aqui

# --- API gov.br - Consulta CPF ---
# Obtenha o token em portal.conecta.apim.gov.br
CPF_API_TOKEN=seu-token-aqui

# --- Inertia ---
INERTIA_SSR_ENABLED=false
INERTIA_USE_SCRIPT_ELEMENT_FOR_INITIAL_PAGE=true

# --- Cache / Session ---
# Local: file/database. Produção (Vercel): array + cookie (FS efêmero).
BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# --- Vite ---
VITE_APP_NAME="${APP_NAME}"
VITE_CLERK_PUBLISHABLE_KEY="${CLERK_PUBLISHABLE_KEY}"
