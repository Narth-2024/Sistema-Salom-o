APP_NAME="Sistema Salomão"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stderr
LOG_LEVEL=error

# --- Database (Supabase PostgreSQL) ---
# Local: host direto (IPv6). Produção (Vercel): session pooler IPv4.
DB_CONNECTION=supabase
DB_HOST=db.SEU-REF.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=

# --- Supabase ---
# Use as chaves LEGACY em formato JWT (eyJ...): Dashboard → Settings → API.
# As chaves no formato sb_secret_/sb_publishable_ NÃO funcionam (Storage/PostgREST rejeitam).
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# --- Autenticação (Clerk) ---
# Login e cadastro são feitos pelos widgets do Clerk. Sem as variáveis abaixo o
# acesso local não funciona. Chaves em dashboard.clerk.com → API keys.
CLERK_PUBLISHABLE_KEY=pk_test_...
# O Vite só injeta no bundle as variáveis com prefixo VITE_.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Frontend API usada como `iss` na validação do session token.
CLERK_FRONTEND_API_URL=https://SEU-DOMINIO.clerk.accounts.dev
# Origem aceita no claim `azp`. Vazio = aceita APP_URL + localhost:5173/8000.
CLERK_AUTHORIZED_PARTY=
# Signing secret do endpoint do Svix (webhook de usuários).
CLERK_WEBHOOK_SECRET=whsec_...

# --- Inertia ---
INERTIA_SSR_ENABLED=false
INERTIA_USE_SCRIPT_ELEMENT_FOR_INITIAL_PAGE=true

# --- Cache / Session ---
# Local: file/database. Produção (Vercel): array + cookie (FS efêmero).
BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# --- E-mail ---
# Hoje o projeto não envia nenhum e-mail: "esqueci a senha" é resolvido pelo
# Clerk, e não há mailables nem notifications no código. Mantidos só o remetente.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@seu-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Cron de transações recorrentes ---
# Protege a rota /cron/recurring (chamada pelo cron da Vercel com ?secret=...).
CRON_SECRET=uma-string-longa-e-aleatoria

# --- Vite ---
VITE_APP_NAME="${APP_NAME}"
