APP_NAME="Sistema Salomão"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stderr
LOG_LEVEL=error

# --- Database (Supabase PostgreSQL) ---
# Local: host direto (IPv6). Produção (Vercel): session pooler IPv4.
DB_CONNECTION=supabase
DB_HOST=db.SEU-REF.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=

# --- Supabase ---
# Use as chaves LEGACY em formato JWT (eyJ...): Dashboard → Settings → API.
# As chaves no formato sb_secret_/sb_publishable_ NÃO funcionam (Storage/PostgREST rejeitam).
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# --- Inertia ---
INERTIA_SSR_ENABLED=false
INERTIA_USE_SCRIPT_ELEMENT_FOR_INITIAL_PAGE=true

# --- Cache / Session ---
# Local: file/database. Produção (Vercel): array + cookie (FS efêmero).
BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# --- E-mail (link de "esqueci a senha") ---
# Sem MAIL_* configurado o e-mail não sai (o sistema só registra um aviso no log).
# Qualquer provedor SMTP serve. Exemplos:
#   Resend  -> MAIL_HOST=smtp.resend.com  MAIL_PORT=465  MAIL_ENCRYPTION=tls
#   Brevo   -> MAIL_HOST=smtp-relay.brevo.com  MAIL_PORT=587  MAIL_ENCRYPTION=tls
#   Gmail   -> MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_ENCRYPTION=tls + senha de app
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="nao-responda@seu-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Cron de transações recorrentes ---
# Protege a rota /cron/recurring (chamada pelo cron da Vercel com ?secret=...).
CRON_SECRET=uma-string-longa-e-aleatoria

# --- Vite ---
VITE_APP_NAME="${APP_NAME}"
